{
  "name": "fsttm-web",
  "version": "0.6.0",
  "type": "module",
  "description": "the FSTTM floor machine in the browser: a dialog framework (lib/: floor machine, attention, dialog with barge-in and the heard-text cut, speechSynthesis) and its reference page (web/) over llama-server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metis-lang-dev/fsttm-web.git"
  },
  "exports": {
    "./fsttm": "./lib/fsttm.js",
    "./attention": "./lib/attention.js",
    "./dialog": "./lib/dialog.js",
    "./tts": "./lib/tts.js",
    "./ws": "./lib/ws.js",
    "./panel": "./lib/panel.js",
    "./panel.css": "./lib/panel.css",
    "./narrator": "./lib/narrator.js",
    "./narrator.css": "./lib/narrator.css",
    "./fsttm.json": "./lib/fsttm.json",
    "./fixtures/*": "./lib/fixtures/*"
  },
  "files": [
    "lib/",
    "README.md"
  ],
  "scripts": {
    "build": "npx tailwindcss@3.4.17 -c tailwind.config.cjs -i web/src/input.css -o web/styles.css --minify",
    "watch": "npx tailwindcss@3.4.17 -c tailwind.config.cjs -i web/src/input.css -o web/styles.css --watch",
    "test": "node test/run.mjs && node test/dialog.mjs && node test/echo.mjs && node test/panel.mjs && node test/ws.mjs && node test/narrator.mjs"
  }
}
